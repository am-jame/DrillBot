# Copy this to bot.env and fill it in. bot.env is git-ignored: it holds the bot's token.
export PYTHONUNBUFFERED=1
# From the Discord Developer Portal → your app → Bot → Reset Token.
export DISCORD_TOKEN=''
# The server where word lists can be edited (Developer Mode → right-click the server → Copy Server ID).
export DISCORD_HOME_GUILD_ID=''
# An email or URL Wikimedia can use to reach you (sent with every Wiktionary lookup).
export WIKTIONARY_CONTACT=''
# Optional, for testing only: register every command instantly in this one server.
# export DISCORD_GUILD_ID=''
