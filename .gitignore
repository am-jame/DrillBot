# Bot settings: holds the Discord token
bot.env

# PyCharm settings (workspace.xml holds the token in the "Run with token" run configuration)
.idea/

# Logs (bot.log rotates to bot.log.1 ... bot.log.5)
bot.log
bot.log.*
service.log

# Word lists: built from cooljugator.com (not openly licensed) and Wiktionary, so not
# published here. Copy words.json between machines like stats.db; it's backed up in backups/.
words.json

# Player data: Discord IDs, names, answers, running quizzes
stats.db
stats.db-journal

# Generated copies and caches
backups/
words.json.bak
meanings.json
*.tmp

# Python
.venv/
__pycache__/

# macOS
.DS_Store

# Test cache
.pytest_cache/
